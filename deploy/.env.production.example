# Deployment contract example. Do not create or commit a real
# deploy/.env.production file.

# -----------------------------------------------------------------------------
# Backend runtime configuration (Elastic Beanstalk)
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

# Both URLs must use the same HTTPS origin. VNPAY_RETURN_URL must have exactly
# the /checkout/return path and no query string or fragment.
FRONTEND_BASE_URL=https://develop.example.amplifyapp.com
VNPAY_RETURN_URL=https://develop.example.amplifyapp.com/checkout/return

# Obtain these values from the VNPay merchant/sandbox portal and keep the real
# values in the deployment secret store.
VNPAY_TMN_CODE=<managed-secret>
VNPAY_HASH_SECRET=<managed-secret>

# The current repository supports demo/UAT through direct-sdk-mock. It trusts the
# browser SDK result only after cross-checking the synthetic mock registry. It is
# NOT real national-ID verification and must not be presented as production CCCD.
KYC_IDENTITY_VERIFICATION_MODE=direct-sdk-mock

# SANDBOX/UAT ONLY: replace the value above with `direct-sdk` to accept the VNPT
# browser callback without server-to-server confirmation and allow that sandbox
# identity to pass the withdrawal KYC gate. Keep all money/provider operations in
# sandbox and configure a stable KYC_IDENTITY_SECRET of at least 32 characters.
KYC_IDENTITY_SECRET=<stable-managed-secret-at-least-32-characters>

# Real production requires KYC_IDENTITY_VERIFICATION_MODE=server, a concrete
# server-to-server VNPT adapter, and provider credentials. The repository's
# current fallback adapter is fail-closed; changing this variable alone is not
# sufficient to enable production verification.

# Real phone verification and every withdrawal confirmation use Firebase Phone
# Auth. FIREBASE_SERVICE_ACCOUNT_JSON_BASE64 is the Base64 encoding of the
# backend service-account JSON. Inject it from AWS Secrets Manager; do not store
# the large private key as an Elastic Beanstalk plain-text property.
PHONE_VERIFICATION_SMS_MODE=firebase
WITHDRAWAL_OTP_MODE=firebase
FIREBASE_PHONE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=<aws-secrets-manager-backed-secret>

# -----------------------------------------------------------------------------
# Frontend build configuration (Amplify branch variables, NOT Elastic Beanstalk)
# -----------------------------------------------------------------------------
# Every VITE_* value below is PUBLIC in the deployed browser bundle. A managed
# environment keeps it out of git/build logs but cannot make it secret. Provision
# only VNPT browser-scoped values approved for public exposure and origin-lock
# them in the VNPT portal. The protected release validator rejects a disabled
# integration, missing placeholders, non-approved VNPT backends, and remote scripts.
VITE_FIREBASE_PHONE_AUTH_ENABLED=true
VITE_FIREBASE_API_KEY=<public-firebase-web-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<firebase-project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<firebase-project-id>
VITE_FIREBASE_APP_ID=<public-firebase-web-app-id>
VITE_FIREBASE_MESSAGING_SENDER_ID=<public-firebase-sender-id>

VITE_VNPT_EKYC_ENABLED=true
VITE_VNPT_EKYC_SDK_SCRIPT_URLS=
VITE_VNPT_EKYC_BACKEND_URL=https://api.idg.vnpt.vn
VITE_VNPT_EKYC_TOKEN_ID=<public-browser-token-id>
VITE_VNPT_EKYC_TOKEN_KEY=<public-browser-token-key>
VITE_VNPT_EKYC_ACCESS_TOKEN=<public-browser-access-token>
# Optional. Leave blank unless VNPT issues a browser challenge code for this app.
VITE_VNPT_EKYC_CHALLENGE_CODE=

# AI provider configuration — see docs/AI_PROVIDER_RUNBOOK.md.
# Obtain these from your OpenAI-compatible provider account.
AI_CHAT_PROVIDER_BASE_URL=<managed-secret>
AI_CHAT_PROVIDER_API_KEY=<managed-secret>
AI_CHAT_PROVIDER_MODEL=<managed-secret>

# Legacy fallback only: if the project deliberately returns to eSMS profile
# verification, replace PHONE_VERIFICATION_SMS_MODE above with `esms` and set
# its API key, secret, Brandname, sandbox=0, and timeout. Withdrawal confirmation
# remains `email` unless WITHDRAWAL_OTP_MODE is also changed deliberately.
