VITE_API_BASE_URL=http://localhost:8081/api
VITE_PAYMENT_DEV_SIMULATOR_ENABLED=false

# VNPT eKYC Web SDK runtime.
# VITE_* values are embedded in the public browser bundle. Use only the browser/client
# credentials issued by VNPT for Web SDK and never place a server API key/client secret here.
# Keep real values out of git and inject them from the frontend deployment environment.
# Use https://api.idg.vnpt.vn when requests must appear in the VNPT admin dashboard.
# Use https://sandbox-idg.vnpt.vn only for isolated sandbox tests.
VITE_VNPT_EKYC_ENABLED=false
VITE_VNPT_EKYC_SDK_SCRIPT_URLS=
VITE_VNPT_EKYC_BACKEND_URL=https://api.idg.vnpt.vn
VITE_VNPT_EKYC_TOKEN_ID=
VITE_VNPT_EKYC_TOKEN_KEY=
VITE_VNPT_EKYC_ACCESS_TOKEN=
