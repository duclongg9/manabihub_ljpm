VITE_API_BASE_URL=http://localhost:8081/api
VITE_PAYMENT_DEV_SIMULATOR_ENABLED=false

# VNPT eKYC Web SDK runtime — PUBLIC browser build configuration.
# Every VITE_* value is embedded in the downloadable JavaScript bundle. Use only
# browser/client values that VNPT explicitly permits to be exposed to end users.
# Never place a server API key, client secret, or unrestricted provider credential here.
# Managed CI/Amplify variables keep values out of git and logs; they do not make
# the values secret after the frontend is built.
# Use https://api.idg.vnpt.vn when requests must appear in the VNPT admin dashboard.
# Use https://sandbox-idg.vnpt.vn only for isolated sandbox tests.
VITE_VNPT_EKYC_ENABLED=false
# Optional comma-separated SDK script URLs. Leave blank to use the committed,
# same-origin SDK assets. Release builds accept only root-relative same-origin paths.
VITE_VNPT_EKYC_SDK_SCRIPT_URLS=
VITE_VNPT_EKYC_BACKEND_URL=https://api.idg.vnpt.vn
VITE_VNPT_EKYC_TOKEN_ID=
VITE_VNPT_EKYC_TOKEN_KEY=
VITE_VNPT_EKYC_ACCESS_TOKEN=
# Optional browser-visible challenge code. Leave blank to use the Web SDK 3.2.1
# default when VNPT has not issued an application-specific value.
VITE_VNPT_EKYC_CHALLENGE_CODE=
